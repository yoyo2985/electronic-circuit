# A1 音频采集最小系统 top_audio
# 时钟/复位同主工程；aud_* 引脚照官方 ES8388 例程（模块 J0 排针，与本工程零冲突）
set_pin_assignment	{ sys_clk }	{ LOCATION = R7; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ sys_rst_n }	{ LOCATION = A9; IOSTANDARD = LVCMOS33; }
# ES8388 I2S / 控制（codec 主时钟：BCLK/LRCK/SDOUT 为输入，MCLK/I2C 为输出）
set_pin_assignment	{ aud_mclk }	{ LOCATION = N5; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ aud_bclk }	{ LOCATION = M6; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ aud_lrc }	{ LOCATION = M7; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ aud_adcdat }	{ LOCATION = R14; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ aud_scl }	{ LOCATION = R12; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ aud_sda }	{ LOCATION = R9; IOSTANDARD = LVCMOS33; }
# UART 上报（115200）
set_pin_assignment	{ tx }	{ LOCATION = D12; IOSTANDARD = LVCMOS33; }
# LED 双声道电平条（左=led[7:4]，右=led[3:0]）
set_pin_assignment	{ led[0] }	{ LOCATION = B14; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ led[1] }	{ LOCATION = B15; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ led[2] }	{ LOCATION = B16; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ led[3] }	{ LOCATION = C15; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ led[4] }	{ LOCATION = C16; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ led[5] }	{ LOCATION = E13; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ led[6] }	{ LOCATION = E16; IOSTANDARD = LVCMOS33; }
set_pin_assignment	{ led[7] }	{ LOCATION = F16; IOSTANDARD = LVCMOS33; }
